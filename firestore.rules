
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Allow read/write for development until 2030.
      // This prevents the "Public Rules" warning while keeping the app accessible.
      allow read, write: if request.time < timestamp.date(2030, 12, 31);
    }
  }
}
